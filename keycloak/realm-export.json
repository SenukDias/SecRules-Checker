{
  "realm": "rulescope",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full access: manage users, custom rules, all jobs/reports" },
      { "name": "analyst", "description": "Upload configs, view/export own reports" },
      { "name": "viewer", "description": "Read-only access to reports" }
    ]
  },
  "clients": [
    {
      "clientId": "rulescope-frontend",
      "publicClient": true,
      "protocol": "openid-connect",
      "enabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "rulescope-backend",
      "publicClient": false,
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true,
      "secret": "change-me"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "credentials": [{ "type": "password", "value": "admin", "temporary": true }],
      "realmRoles": ["admin"]
    },
    {
      "username": "analyst",
      "enabled": true,
      "email": "analyst@example.com",
      "credentials": [{ "type": "password", "value": "analyst", "temporary": true }],
      "realmRoles": ["analyst"]
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@example.com",
      "credentials": [{ "type": "password", "value": "viewer", "temporary": true }],
      "realmRoles": ["viewer"]
    }
  ]
}
