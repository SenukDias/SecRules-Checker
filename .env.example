# Postgres (app database)
POSTGRES_USER=rulescope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rulescope

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_REALM=rulescope
KEYCLOAK_CLIENT_ID=rulescope-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_FRONTEND_CLIENT_ID=rulescope-frontend

# Frontend build-time URLs
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8081

# IP/ISP enrichment (all optional - free tiers used by default)
IPINFO_TOKEN=
IPWHOIS_ENABLED=true
IPAPI_ENABLED=true
FREEIPAPI_ENABLED=true

# Uploads
MAX_UPLOAD_SIZE_MB=25
UPLOAD_ENCRYPTION_KEY=
